{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuanyu.local/ai-council/schemas/message.schema.json",
  "title": "AI Council Message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "meeting_id",
    "phase_id",
    "sender",
    "recipients",
    "content",
    "validation",
    "accepted_by_runtime",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "meeting_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "event_seq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "alias"
      ],
      "properties": {
        "actor_type": {
          "enum": [
            "human_arbiter",
            "chair",
            "secretary",
            "agent",
            "system"
          ]
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "role_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recipients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope"
      ],
      "properties": {
        "scope": {
          "enum": [
            "meeting",
            "side",
            "participants",
            "chair",
            "secretary",
            "human_arbiter",
            "system"
          ]
        },
        "side_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "participant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "side"
              }
            }
          },
          "then": {
            "required": [
              "side_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "participants"
              }
            }
          },
          "then": {
            "required": [
              "participant_ids"
            ]
          }
        }
      ]
    },
    "identity_visibility_mode": {
      "enum": [
        "public",
        "semi_anonymous",
        "full_anonymous"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_text"
      ],
      "properties": {
        "raw_text": {
          "type": "string"
        },
        "structured_output": {},
        "content_type": {
          "enum": [
            "text",
            "structured_json",
            "mixed"
          ]
        }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "message_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "event_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "errors"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "valid",
            "invalid",
            "corrected"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "accepted_by_runtime": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
