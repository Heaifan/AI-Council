{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xuanyu.local/ai-council/schemas/role.schema.json",
  "title": "AI Council Role Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role_id",
    "name",
    "version",
    "source",
    "role_class",
    "description",
    "responsibilities",
    "focus_areas",
    "behavioral_constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "source": {
      "enum": [
        "built_in",
        "prototype",
        "manual",
        "ai_generated"
      ]
    },
    "role_class": {
      "enum": [
        "advisor",
        "chair",
        "secretary",
        "chair_secretary"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "responsibilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "focus_areas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "behavioral_constraints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "task_guidance": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
